# crowdfunding-server Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Node environment: development | production | test
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Stripe secret key (sk_test_* for dev, sk_live_* for prod)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
